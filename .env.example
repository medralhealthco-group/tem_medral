# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Set to "true" to activate the Coming Soon page for all public routes
SHOW_COMING_SOON=false

# ─── Hostinger MySQL Database Configuration ────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u706689513_medralhealth
DB_USER=u706689513_prince
DB_PASSWORD=your_database_password_here

# ─── Session Security Configuration ───────────────────────────────────────────
# Must be a long random secret — minimum 32 characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_minimum_32_chars

# ─── Asset Versioning (Cache Busting) ─────────────────────────────────────────
# Increment this value with each deployment to bust browser caches.
ASSET_VERSION=1.0.0

# ─── Public Site URL (SEO canonicals, Open Graph, sitemap, robots) ────────────
# Production should be the live HTTPS origin without a trailing slash.
SITE_URL=https://www.medralhealth.com

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
# Defaults to "info" in production, "debug" in development.
LOG_LEVEL=info

# ─── Health endpoint ──────────────────────────────────────────────────────────
# Optional. When set, GET /health with header X-Health-Token returns diagnostics.
# Public /health only returns { "status": "ok"|"degraded" }.
HEALTH_TOKEN=

# ─── Contact / Lead Notification Email (optional but recommended) ─────────────
# When unset, enquiries are still saved to `contact_submissions` (DB-only).
# Password reset emails also require SMTP; in development the reset URL is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Medral Health <noreply@medralhealth.com>"
CONTACT_NOTIFY_TO=sales@medralhealth.com
