<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include('../partials/head-seo') %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="/assets/css/fonts.css" rel="stylesheet" />
    <link href="/assets/css/storefront.bundle.css?v=<%= assetVersion %>" rel="stylesheet" type="text/css" media="all" />
  </head>
  <body>
    <%- include('../partials/header') %>

    <main class="auth-container" id="main-content" role="main" aria-label="Reset Password">
      <div class="auth-card">
        <div class="auth-header">
          <h1 class="auth-title">Reset Password</h1>
          <p class="auth-subtitle">
            <% if (tokenValid) { %>
              Choose a new password for your account
            <% } else { %>
              This reset link is no longer valid
            <% } %>
          </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="auth-alert auth-alert--danger" role="alert" aria-live="assertive">
            <%= error %>
          </div>
        <% } %>

        <% if (tokenValid) { %>
        <form action="/account/reset-password" method="POST">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="token" value="<%= token %>">

          <div class="auth-form-group">
            <label for="newPassword" class="auth-label">New Password <span aria-hidden="true">*</span></label>
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              class="auth-input"
              placeholder="At least 8 characters"
              required
              aria-required="true"
              minlength="8"
              autocomplete="new-password"
              autofocus
            />
          </div>

          <div class="auth-form-group">
            <label for="confirmPassword" class="auth-label">Confirm Password <span aria-hidden="true">*</span></label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              class="auth-input"
              placeholder="Re-enter new password"
              required
              aria-required="true"
              minlength="8"
              autocomplete="new-password"
            />
          </div>

          <p class="auth-hint">Use at least 8 characters with a letter and a number or symbol.</p>

          <button type="submit" class="auth-btn">Update Password</button>
        </form>
        <% } %>

        <div class="auth-footer-link">
          <a href="/account/forgot-password">Request a new link</a>
          &nbsp;·&nbsp;
          <a href="/account/login">Sign in</a>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
