<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Category Management | Medral Health Admin' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="/assets/css/fonts.css" rel="stylesheet" />
    <link href="/assets/css/admin-base.css" rel="stylesheet" />
    <link rel="icon" href="/assets/images/favicon.png" type="image/png">
  </head>
  <body data-theme="admin">
    <%- include('../partials/sidebar') %>

    <div class="admin-wrapper">
      <%- include('../partials/header', { pageTitle: 'Category Management' }) %>

      <main class="admin-content">
        <div class="page-actions-bar">
          <h1 class="admin-page-title">Product Categories</h1>
          <a href="/admin/categories/create" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Add Category</span>
          </a>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="table-card">
          <div class="table-card-header">
            <form action="/admin/categories" method="GET" class="search-form">
              <input
                type="text"
                name="search"
                class="search-input"
                placeholder="Search categories..."
                value="<%= typeof pagination !== 'undefined' ? pagination.search : '' %>"
              />
              <button type="submit" class="search-btn">Search</button>
            </form>
            <div class="table-summary-count">
              Total: <strong><%= pagination.totalCount %></strong> Categories
            </div>
          </div>

          <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th class="col-w-60">ID</th>
                  <th>Category Name</th>
                  <th>Slug</th>
                  <th class="col-w-100">Order</th>
                  <th class="col-w-100">Status</th>
                  <th class="text-right col-w-160">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (categories && categories.length > 0) { %>
                  <% categories.forEach(cat => { %>
                    <tr>
                      <td>#<%= cat.id %></td>
                      <td>
                        <strong class="product-title"><%= cat.name %></strong>
                        <% if (cat.description) { %>
                          <p class="category-description"><%= cat.description.substring(0, 70) %><%= cat.description.length > 70 ? '...' : '' %></p>
                        <% } %>
                      </td>
                      <td><code class="product-sku-code"><%= cat.slug %></code></td>
                      <td><%= cat.display_order %></td>
                      <td>
                        <% if (cat.is_active) { %>
                          <span class="badge badge-success">Active</span>
                        <% } else { %>
                          <span class="badge badge-secondary">Inactive</span>
                        <% } %>
                      </td>
                      <td class="text-right">
                        <div class="action-btns text-right">
                          <a href="/admin/categories/edit/<%= cat.id %>" class="btn-sm btn-edit">Edit</a>
                          <form action="/admin/categories/delete/<%= cat.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete category \'<%= cat.name %>\'?');" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button type="submit" class="btn-sm btn-delete">Delete</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="table-empty">
                      No categories found. Click <strong>Add Category</strong> above to create your first category.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (pagination.totalPages > 1) { %>
            <div class="pagination-container">
              <div>
                Showing Page <strong><%= pagination.page %></strong> of <strong><%= pagination.totalPages %></strong>
              </div>
              <div class="pagination-links">
                <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                  <a href="/admin/categories?page=<%= i %>&search=<%= encodeURIComponent(pagination.search) %>" class="page-link <%= pagination.page === i ? 'active' : '' %>">
                    <%= i %>
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </body>
</html>

