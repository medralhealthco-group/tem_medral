<header class="admin-header">
  <div class="admin-header__left">
    <button class="admin-sidebar-toggle" id="sidebarToggle" aria-label="Toggle Sidebar">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div class="admin-breadcrumb">
      <span class="admin-breadcrumb__title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Store Administration' %></span>
    </div>
  </div>

  <div class="admin-header__right">
    <div class="admin-user-pill">
      <div class="admin-avatar">
        <%= typeof currentAdmin !== 'undefined' && currentAdmin && currentAdmin.fullName ? currentAdmin.fullName.charAt(0).toUpperCase() : 'A' %>
      </div>
      <div class="admin-user-info">
        <span class="admin-user-name"><%= typeof currentAdmin !== 'undefined' && currentAdmin ? currentAdmin.fullName : 'Administrator' %></span>
        <span class="admin-user-role"><%= typeof currentAdmin !== 'undefined' && currentAdmin ? currentAdmin.role : 'superadmin' %></span>
      </div>
    </div>

    <form action="/admin/logout" method="POST" style="display:inline; margin:0;">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
      <button type="submit" class="admin-logout-btn" title="Sign Out">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Logout</span>
      </button>
    </form>
  </div>
</header>
