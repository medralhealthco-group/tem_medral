<aside class="admin-sidebar" id="adminSidebar">
  <div class="admin-sidebar__head">
    <a href="/admin/dashboard" class="admin-sidebar__logo">
      <img src="<%= typeof config !== 'undefined' && config.theme ? config.theme.logo : '/assets/images/Medral_Logo.png' %>" alt="<%= typeof config !== 'undefined' && config.site ? config.site.name : 'Medral Health' %>" />
      <span class="admin-sidebar__brand-tag">STORE ADMIN</span>
    </a>
  </div>

  <nav class="admin-sidebar__nav">
    <div class="admin-nav-section">Main Menu</div>
    
    <a href="/admin/dashboard" class="admin-nav-item <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span>Dashboard</span>
    </a>

    <div class="admin-nav-section">Catalog Management</div>

    <a href="/admin/categories" class="admin-nav-item <%= typeof activePage !== 'undefined' && activePage === 'categories' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
      </svg>
      <span>Categories</span>
    </a>

    <a href="/admin/subcategories" class="admin-nav-item <%= typeof activePage !== 'undefined' && activePage === 'subcategories' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="8" y1="6" x2="21" y2="6"></line>
        <line x1="8" y1="12" x2="21" y2="12"></line>
        <line x1="8" y1="18" x2="21" y2="18"></line>
        <line x1="3" y1="6" x2="3.01" y2="6"></line>
        <line x1="3" y1="12" x2="3.01" y2="12"></line>
        <line x1="3" y1="18" x2="3.01" y2="18"></line>
      </svg>
      <span>Subcategories</span>
    </a>

    <a href="/admin/products" class="admin-nav-item <%= typeof activePage !== 'undefined' && activePage === 'products' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
      </svg>
      <span>Products</span>
    </a>

    <a href="/admin/orders" class="admin-nav-item <%= typeof activePage !== 'undefined' && activePage === 'orders' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <span>Orders</span>
    </a>

    <div class="admin-nav-section">System & Security</div>

    <a href="/admin/change-password" class="admin-nav-item <%= typeof activePage !== 'undefined' && activePage === 'change-password' ? 'active' : '' %>">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>Change Password</span>
    </a>

    <a href="/" target="_blank" rel="noopener" class="admin-nav-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      <span>View Live Website</span>
    </a>
