<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= isEdit ? 'Edit Product' : 'Add Product' %> | Medral Health Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="/assets/css/fonts.css" rel="stylesheet" />
    <link href="/assets/css/admin-base.css" rel="stylesheet" />
    <link rel="icon" href="/assets/images/favicon.png" type="image/png">
  </head>
  <body data-theme="admin">
    <%- include('../partials/sidebar') %>

    <div class="admin-wrapper">
      <%- include('../partials/header', { pageTitle: isEdit ? 'Edit Product' : 'Add Product' }) %>

      <main class="admin-content">
        <div class="form-card">
          <h1 class="form-card-title"><%= isEdit ? 'Edit Catalog Product' : 'Add New Catalog Product' %></h1>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <form action="<%= isEdit ? '/admin/products/edit/' + product.id : '/admin/products/create' %>" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="form-group">
              <label for="title" class="form-label">Product Title *</label>
              <input
                type="text"
                id="title"
                name="title"
                class="form-input"
                value="<%= product ? product.title : '' %>"
                placeholder="e.g., Whey Protein Isolate 1kg"
                required
                autofocus
              />
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="sku" class="form-label">SKU Code *</label>
                <input
                  type="text"
                  id="sku"
                  name="sku"
                  class="form-input"
                  value="<%= product ? product.sku : '' %>"
                  placeholder="e.g., MH-WPI-1001"
                  required
                />
              </div>

              <div class="form-group">
                <label for="slug" class="form-label">URL Slug (Auto-generated if blank)</label>
                <input
                  type="text"
                  id="slug"
                  name="slug"
                  class="form-input"
                  value="<%= product ? product.slug : '' %>"
                  placeholder="e.g., whey-protein-isolate-1kg"
                />
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="category_id" class="form-label">Category *</label>
                <select id="category_id" name="category_id" class="form-select" required onchange="loadSubcategories(this.value)">
                  <option value="">-- Select Category --</option>
                  <% if (categories && categories.length > 0) { %>
                    <% categories.forEach(cat => { %>
                      <option value="<%= cat.id %>" <%= product && product.category_id == cat.id ? 'selected' : '' %>>
                        <%= cat.name %>
                      </option>
                    <% }); %>
                  <% } %>
                </select>
              </div>

              <div class="form-group">
                <label for="subcategory_id" class="form-label">Subcategory (Optional)</label>
                <select id="subcategory_id" name="subcategory_id" class="form-select">
                  <option value="">-- None / Select Subcategory --</option>
                  <% if (subcategories && subcategories.length > 0) { %>
                    <% subcategories.forEach(sub => { %>
                      <option value="<%= sub.id %>" <%= product && product.subcategory_id == sub.id ? 'selected' : '' %>>
                        <%= sub.name %>
                      </option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="brand" class="form-label">Brand</label>
                <input
                  type="text"
                  id="brand"
                  name="brand"
                  class="form-input"
                  value="<%= product && product.brand ? product.brand : 'Medral Health' %>"
                />
              </div>

              <div class="form-group">
                <label for="stock_quantity" class="form-label">Stock Quantity</label>
                <input
                  type="number"
                  id="stock_quantity"
                  name="stock_quantity"
                  class="form-input"
                  value="<%= product && product.stock_quantity !== undefined ? product.stock_quantity : 0 %>"
                  min="0"
                />
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="price" class="form-label">Regular Price (₹) *</label>
                <input
                  type="number"
                  step="0.01"
                  id="price"
                  name="price"
                  class="form-input"
                  value="<%= product ? product.price : '' %>"
                  placeholder="0.00"
                  required
                />
              </div>

              <div class="form-group">
                <label for="sale_price" class="form-label">Sale Price (₹ Optional)</label>
                <input
                  type="number"
                  step="0.01"
                  id="sale_price"
                  name="sale_price"
                  class="form-input"
                  value="<%= product && product.sale_price ? product.sale_price : '' %>"
                  placeholder="0.00"
                />
              </div>
            </div>

            <div class="form-group">
              <label for="short_description" class="form-label">Short Summary</label>
              <textarea
                id="short_description"
                name="short_description"
                class="form-textarea"
                placeholder="Brief high-level summary displayed on product cards..."
              ><%= product ? product.short_description : '' %></textarea>
            </div>

            <div class="form-group">
              <label for="full_description" class="form-label">Full Product Specification / Description</label>
              <textarea
                id="full_description"
                name="full_description"
                class="form-textarea form-textarea-lg"
                placeholder="Detailed nutritional info, usage instructions, ingredients..."
              ><%= product ? product.full_description : '' %></textarea>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="status" class="form-label">Visibility Status</label>
                <select id="status" name="status" class="form-select">
                  <option value="draft" <%= !product || product.status === 'draft' ? 'selected' : '' %>>Draft (Hidden)</option>
                  <option value="published" <%= product && product.status === 'published' ? 'selected' : '' %>>Published (Live in Shop)</option>
                </select>
              </div>

              <div class="form-group form-align-end">
                <label class="form-checkbox-label">
                  <input
                    type="checkbox"
                    name="is_featured"
                    value="1"
                    <%= product && product.is_featured ? 'checked' : '' %>
                  />
                  <span>Mark as Featured Product</span>
                </label>
              </div>
            </div>

            <!-- Product Gallery File Uploads -->
            <div class="form-group form-group-spaced">
              <label for="images" class="form-label">Upload Product Gallery Images (PNG, JPG, WEBP - Max 5MB)</label>
              <input
                type="file"
                id="images"
                name="images"
                class="form-input"
                multiple
                accept="image/png, image/jpeg, image/jpg, image/webp"
              />
            </div>

            <!-- Existing Gallery Images Manager -->
            <% if (isEdit && product && product.images && product.images.length > 0) { %>
              <div class="form-group">
                <label class="form-label">Existing Gallery Images</label>
                <div class="gallery-grid">
                  <% product.images.forEach(img => { %>
                    <div class="gallery-item">
                      <img src="<%= img.image_url %>" alt="Gallery item" class="gallery-img" />
                      <form action="/admin/products/delete-image/<%= img.id %>" method="POST" onsubmit="return confirm('Delete this image?');">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <input type="hidden" name="product_id" value="<%= product.id %>" />
                        <button type="submit" class="gallery-del-btn" title="Remove image">&times;</button>
                      </form>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } %>

            <div class="form-actions">
              <button type="submit" class="btn-submit"><%= isEdit ? 'Update Product' : 'Publish Product' %></button>
              <a href="/admin/products" class="btn-cancel">Cancel</a>
            </div>
          </form>
        </div>
      </main>


      <%- include('../partials/footer') %>
    </div>

    <script nonce="<%= cspNonce %>">
      // Dynamic Subcategory Fetching via AJAX
      async function loadSubcategories(categoryId) {
        const subSelect = document.getElementById('subcategory_id');
        subSelect.innerHTML = '<option value="">Loading subcategories...</option>';
        
        if (!categoryId) {
          subSelect.innerHTML = '<option value="">-- None / Select Subcategory --</option>';
          return;
        }

        try {
          const res = await fetch('/admin/products/api/subcategories/' + categoryId);
          const data = await res.json();
          subSelect.innerHTML = '<option value="">-- None / Select Subcategory --</option>';
          
          if (data.success && data.subcategories && data.subcategories.length > 0) {
            data.subcategories.forEach(sub => {
              const opt = document.createElement('option');
              opt.value = sub.id;
              opt.textContent = sub.name;
              subSelect.appendChild(opt);
            });
          }
        } catch (e) {
          subSelect.innerHTML = '<option value="">-- None / Select Subcategory --</option>';
        }
      }
    </script>
  </body>
</html>
