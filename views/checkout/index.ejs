<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include('../partials/head-seo') %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="/assets/css/fonts.css" rel="stylesheet" />
    <link href="/assets/css/storefront.bundle.css?v=<%= assetVersion %>" rel="stylesheet" type="text/css" media="all" />
  </head>
  <body>
    <%- include('../partials/header', { headerVariant: 'minimal' }) %>

    <section class="page-hero">
      <h1 class="page-hero__title">Checkout Order</h1>
    </section>

    <div class="checkout-layout">
      <main class="checkout-main" id="main-content" role="main" aria-label="Checkout">
        <div class="form-card">
          <h2 class="form-card-title">1. Shipping & Contact Information</h2>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-danger" role="alert" aria-live="assertive"><%= error %></div>
          <% } %>

          <% const fe = typeof fieldErrors !== 'undefined' && fieldErrors ? fieldErrors : {}; %>

          <form action="/checkout" method="POST" id="checkoutForm" novalidate>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="form-grid">
              <div class="form-group">
                <label for="name" class="form-label">Full Name <span aria-hidden="true">*</span></label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="form-input<%= fe.name ? ' is-invalid' : '' %>"
                  value="<%= formData.name %>"
                  required
                  aria-required="true"
                  aria-describedby="name-error"
                  aria-invalid="<%= fe.name ? 'true' : 'false' %>"
                  autocomplete="name"
                  minlength="2"
                  maxlength="80"
                  pattern="[A-Za-z][A-Za-z .'\-]{1,79}"
                  placeholder="John Doe"
                />
                <p class="form-error" id="name-error" role="alert" <%= fe.name ? '' : 'hidden' %>><%= fe.name || '' %></p>
              </div>
              <div class="form-group">
                <label for="phone" class="form-label">Phone Number <span aria-hidden="true">*</span></label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="form-input<%= fe.phone ? ' is-invalid' : '' %>"
                  value="<%= formData.phone %>"
                  required
                  aria-required="true"
                  aria-describedby="phone-error"
                  aria-invalid="<%= fe.phone ? 'true' : 'false' %>"
                  autocomplete="tel"
                  inputmode="tel"
                  maxlength="16"
                  placeholder="+91 98765 43210"
                />
                <p class="form-hint">10-digit Indian mobile (starts with 6–9)</p>
                <p class="form-error" id="phone-error" role="alert" <%= fe.phone ? '' : 'hidden' %>><%= fe.phone || '' %></p>
              </div>
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email Address <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input<%= fe.email ? ' is-invalid' : '' %>"
                value="<%= formData.email %>"
                required
                aria-required="true"
                aria-describedby="email-error"
                aria-invalid="<%= fe.email ? 'true' : 'false' %>"
                autocomplete="email"
                maxlength="120"
                placeholder="john@example.com"
              />
              <p class="form-error" id="email-error" role="alert" <%= fe.email ? '' : 'hidden' %>><%= fe.email || '' %></p>
            </div>

            <div class="form-group">
              <label for="address" class="form-label">Street Address <span aria-hidden="true">*</span></label>
              <input
                type="text"
                id="address"
                name="address"
                class="form-input<%= fe.address ? ' is-invalid' : '' %>"
                value="<%= formData.address %>"
                required
                aria-required="true"
                aria-describedby="address-error"
                aria-invalid="<%= fe.address ? 'true' : 'false' %>"
                autocomplete="street-address"
                minlength="10"
                maxlength="200"
                placeholder="Flat / House No., Colony / Street"
              />
              <p class="form-error" id="address-error" role="alert" <%= fe.address ? '' : 'hidden' %>><%= fe.address || '' %></p>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="city" class="form-label">City / Town <span aria-hidden="true">*</span></label>
                <input
                  type="text"
                  id="city"
                  name="city"
                  class="form-input<%= fe.city ? ' is-invalid' : '' %>"
                  value="<%= formData.city %>"
                  required
                  aria-required="true"
                  aria-describedby="city-error"
                  aria-invalid="<%= fe.city ? 'true' : 'false' %>"
                  autocomplete="address-level2"
                  minlength="2"
                  maxlength="60"
                  pattern="[A-Za-z][A-Za-z .'\-]{1,59}"
                  placeholder="Mumbai"
                />
                <p class="form-error" id="city-error" role="alert" <%= fe.city ? '' : 'hidden' %>><%= fe.city || '' %></p>
              </div>
              <div class="form-group">
                <label for="state" class="form-label">State <span aria-hidden="true">*</span></label>
                <input
                  type="text"
                  id="state"
                  name="state"
                  class="form-input<%= fe.state ? ' is-invalid' : '' %>"
                  value="<%= formData.state %>"
                  required
                  aria-required="true"
                  aria-describedby="state-error"
                  aria-invalid="<%= fe.state ? 'true' : 'false' %>"
                  autocomplete="address-level1"
                  minlength="2"
                  maxlength="60"
                  pattern="[A-Za-z][A-Za-z .'\-]{1,59}"
                  placeholder="Maharashtra"
                />
                <p class="form-error" id="state-error" role="alert" <%= fe.state ? '' : 'hidden' %>><%= fe.state || '' %></p>
              </div>
            </div>

            <div class="form-group" style="max-width: 50%;">
              <label for="pincode" class="form-label">PIN Code <span aria-hidden="true">*</span></label>
              <input
                type="text"
                id="pincode"
                name="pincode"
                class="form-input<%= fe.pincode ? ' is-invalid' : '' %>"
                value="<%= formData.pincode %>"
                required
                aria-required="true"
                aria-describedby="pincode-error"
                aria-invalid="<%= fe.pincode ? 'true' : 'false' %>"
                autocomplete="postal-code"
                inputmode="numeric"
                minlength="6"
                maxlength="6"
                pattern="[1-9][0-9]{5}"
                placeholder="400001"
              />
              <p class="form-error" id="pincode-error" role="alert" <%= fe.pincode ? '' : 'hidden' %>><%= fe.pincode || '' %></p>
            </div>

            <h2 class="form-card-title" style="margin-top: 36px;">2. Payment Method</h2>

            <label class="payment-option">
              <input type="radio" name="payment_method" value="cod" <%= formData.payment_method === 'cod' ? 'checked' : '' %> />
              <div>
                <strong >Cash on Delivery (COD)</strong>
                <p >Pay with cash upon delivery at your doorstep.</p>
              </div>
            </label>

            <label class="payment-option">
              <input type="radio" name="payment_method" value="bank_transfer" <%= formData.payment_method === 'bank_transfer' ? 'checked' : '' %> />
              <div>
                <strong >Direct Bank Transfer</strong>
                <p >Make payment directly into our bank account.</p>
              </div>
            </label>
          </form>
        </div>
      </main>

      <!-- Sidebar Order Summary -->
      <aside class="checkout-sidebar">
        <div class="summary-card">
          <h3 class="form-card-title" >Order Summary</h3>
          <div class="summary-item-list">
            <% if (cart && cart.items) { %>
              <% cart.items.forEach(item => { %>
                <div class="summary-item">
                  <img src="<%= item.primaryImage %>" alt="" aria-hidden="true" class="summary-item-img" onerror="this.src='/assets/images/Medral_Logo.png';" />
                  <div class="summary-item-info">
                    <div class="summary-item-title"><%= item.title %></div>
                    <div class="summary-item-qty">Qty: <%= item.quantity %> &times; ₹<%= parseFloat(item.price).toFixed(2) %></div>
                  </div>
                  <div class="summary-item-price">₹<%= parseFloat(item.lineTotal).toFixed(2) %></div>
                </div>
              <% }); %>
            <% } %>
          </div>

          <div class="summary-row">
            <span>Subtotal</span>
            <strong>₹<%= parseFloat(cart.subtotal).toFixed(2) %></strong>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span >FREE</span>
          </div>
          <div class="summary-row total-row">
            <span>Grand Total</span>
            <strong >₹<%= parseFloat(cart.subtotal).toFixed(2) %></strong>
          </div>

          <button type="submit" form="checkoutForm" class="btn-place-order" aria-label="Submit order and confirm placement">Place Order Now &rarr;</button>
        </div>
      </aside>
    </div>

    <%- include('../partials/footer') %>
    <script src="/assets/js/checkout.js?v=<%= assetVersion %>" defer nonce="<%= cspNonce %>"></script>
  </body>
</html>
