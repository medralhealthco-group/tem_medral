        <script nonce="<%= cspNonce %>">
          document.addEventListener("DOMContentLoaded", function () {
            var sid = "template--20946532663474__clients_slider_x8ALVf";
            var track = document.getElementById("cslTrack-" + sid);
            var viewport = document.getElementById("cslViewport-" + sid);
            var btnPrev = document.getElementById("cslPrev-" + sid);
            var btnNext = document.getElementById("cslNext-" + sid);
            var dotsWrap = document.getElementById("cslDots-" + sid);

            if (!track || !viewport) return;

            var GAP = 16;
            var COLS_DESKTOP = 7;
            var COLS_TABLET = 3;
            var COLS_MOBILE = 2;
            var current = 0;
            var cards = Array.from(track.children);
            var total = cards.length;

            if (total === 0) return;

            function getVisible() {
              var vw = viewport.offsetWidth;
              if (vw < 480) return Math.min(COLS_MOBILE, total);
              if (vw < 900) return Math.min(COLS_TABLET, total);
              return Math.min(COLS_DESKTOP, total);
            }

            function sizeCards() {
              var vis = getVisible();
              var w = (viewport.offsetWidth - GAP * (vis - 1)) / vis;
              cards.forEach(function (c) {
                c.style.width = w + "px";
                c.style.minWidth = w + "px";
              });
            }

            function totalPages() {
              return Math.max(1, Math.ceil(total / getVisible()));
            }

            function buildDots() {
              dotsWrap.innerHTML = "";
              var p = totalPages();
              dotsWrap.style.display = p <= 1 ? "none" : "flex";
              for (var i = 0; i < p; i++) {
                (function (idx) {
                  var d = document.createElement("button");
                  d.className =
                    "csl-dot" + (idx === current ? " is-active" : "");
                  d.setAttribute("aria-label", "Page " + (idx + 1));
                  d.addEventListener("click", function () {
                    goTo(idx);
                  });
                  dotsWrap.appendChild(d);
                })(i);
              }
            }

            function goTo(idx) {
              var pages = totalPages();
              current = Math.max(0, Math.min(idx, pages - 1));
              var vis = getVisible();
              var w = cards[0].offsetWidth;
              track.style.transform =
                "translateX(-" + current * vis * (w + GAP) + "px)";
              btnPrev.disabled = current === 0;
              btnNext.disabled = current >= pages - 1;
              var dots = dotsWrap.querySelectorAll(".csl-dot");
              dots.forEach(function (d, i) {
                d.classList.toggle("is-active", i === current);
              });
            }

            btnPrev.addEventListener("click", function () {
              goTo(current - 1);
            });
            btnNext.addEventListener("click", function () {
              goTo(current + 1);
            });

            var timer;
            function startAuto() {
              stopAuto();
              if (totalPages() <= 1) return;
              timer = setInterval(function () {
                goTo(current + 1 < totalPages() ? current + 1 : 0);
              }, 4000);
            }
            function stopAuto() {
              clearInterval(timer);
            }

            viewport.addEventListener("mouseenter", stopAuto);
            viewport.addEventListener("mouseleave", startAuto);

            var tx = 0;
            viewport.addEventListener(
              "touchstart",
              function (e) {
                tx = e.touches[0].clientX;
              },
              { passive: true },
            );
            viewport.addEventListener("touchend", function (e) {
              var diff = tx - e.changedTouches[0].clientX;
              if (Math.abs(diff) > 40)
                goTo(diff > 0 ? current + 1 : current - 1);
            });

            var resizeTimer;
            window.addEventListener("resize", function () {
              clearTimeout(resizeTimer);
              resizeTimer = setTimeout(function () {
                sizeCards();
                buildDots();
                goTo(0);
              }, 120);
            });

            sizeCards();
            buildDots();
            goTo(0);
            startAuto();
          });
        </script>
