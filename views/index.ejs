        <script nonce="<%= cspNonce %>">
          document.addEventListener("DOMContentLoaded", function () {
            var sid = "template--20946532663474__hero_slider_JAVAdh";
            var track = document.getElementById("hsTrack-" + sid);
            var btnPrev = document.getElementById("hsPrev-" + sid);
            var btnNext = document.getElementById("hsNext-" + sid);
            var dotsWrap = document.getElementById("hsDots-" + sid);
            var counter = document.getElementById("hsCounter-" + sid);
            var bar = document.getElementById("hsBar-" + sid);

            if (!track) return;

            var slides = Array.from(track.children);
            var total = slides.length;
            var current = 0;
            var autoplay = true;
            var interval = 5 * 1000;
            var timer, barTimer, barStart;

            if (total === 0) return;

            /* Build dots */
            function buildDots() {
              dotsWrap.innerHTML = "";
              for (var i = 0; i < total; i++) {
                (function (idx) {
                  var d = document.createElement("button");
                  d.className =
                    "hs-dot" + (idx === current ? " is-active" : "");
                  d.setAttribute("aria-label", "Slide " + (idx + 1));
                  d.addEventListener("click", function () {
                    goTo(idx);
                  });
                  dotsWrap.appendChild(d);
                })(i);
              }
            }

            /* Update counter */
            function updateCounter() {
              if (counter) {
                counter.innerHTML =
                  "<strong>0" + (current + 1) + "</strong> / 0" + total;
              }
            }

            /* Progress bar */
            function startBar() {
              if (!bar) return;
              bar.style.transition = "none";
              bar.style.width = "0%";
              clearInterval(barTimer);
              barStart = Date.now();
              barTimer = setInterval(function () {
                var elapsed = Date.now() - barStart;
                var pct = Math.min((elapsed / interval) * 100, 100);
                bar.style.transition = "width 0.1s linear";
                bar.style.width = pct + "%";
                if (pct >= 100) clearInterval(barTimer);
              }, 80);
            }

            /* Go to slide */
            function goTo(idx) {
              current = (idx + total) % total;
              track.style.transform = "translateX(-" + current * 100 + "%)";
              slides.forEach(function (slide, i) {
                slide.classList.toggle("is-active", i === current);
                slide.setAttribute("aria-hidden", i === current ? "false" : "true");
              });
              dotsWrap.querySelectorAll(".hs-dot").forEach(function (d, i) {
                d.classList.toggle("is-active", i === current);
              });
              btnPrev.disabled = false;
              btnNext.disabled = false;
              updateCounter();
              if (autoplay) startBar();
            }

            btnPrev.addEventListener("click", function () {
              stopAuto();
              goTo(current - 1);
            });
            btnNext.addEventListener("click", function () {
              stopAuto();
              goTo(current + 1);
            });

            /* Auto-play */
            function startAuto() {
              if (!autoplay) return;
              stopAuto();
              startBar();
              timer = setInterval(function () {
                goTo(current + 1);
              }, interval);
            }
            function stopAuto() {
              clearInterval(timer);
              clearInterval(barTimer);
            }

            /* Pause on hover (skip while dragging) */
            track.addEventListener("mouseenter", function () {
              if (!dragging) stopAuto();
            });
            track.addEventListener("mouseleave", function () {
              if (!dragging) startAuto();
            });

            /* Pointer swipe (mouse + touch) — avoid text selection */
            var dragStartX = 0;
            var dragging = false;
            var didSwipe = false;
            var SWIPE_THRESHOLD = 50;

            function pointerTargetIsInteractive(target) {
              return !!(target && target.closest && target.closest("a, button, input, textarea, select, label"));
            }

            function onPointerDown(e) {
              if (e.pointerType === "mouse" && e.button !== 0) return;
              if (pointerTargetIsInteractive(e.target)) return;
              dragging = true;
              didSwipe = false;
              dragStartX = e.clientX;
              track.classList.add("is-dragging");
              stopAuto();
              try {
                track.setPointerCapture(e.pointerId);
              } catch (err) {
                /* ignore */
              }
            }

            function onPointerMove(e) {
              if (!dragging) return;
              if (Math.abs(e.clientX - dragStartX) > 8) {
                didSwipe = true;
                e.preventDefault();
              }
            }

            function onPointerUp(e) {
              if (!dragging) return;
              dragging = false;
              track.classList.remove("is-dragging");
              try {
                track.releasePointerCapture(e.pointerId);
              } catch (err) {
                /* ignore */
              }
              var diff = dragStartX - e.clientX;
              if (Math.abs(diff) > SWIPE_THRESHOLD) {
                goTo(diff > 0 ? current + 1 : current - 1);
              }
              startAuto();
            }

            track.addEventListener("pointerdown", onPointerDown);
            track.addEventListener("pointermove", onPointerMove, { passive: false });
            track.addEventListener("pointerup", onPointerUp);
            track.addEventListener("pointercancel", onPointerUp);

            /* Don't follow links if the gesture was a swipe */
            track.addEventListener("click", function (e) {
              if (didSwipe) {
                e.preventDefault();
                e.stopPropagation();
                didSwipe = false;
              }
            }, true);

            /* Keyboard */
            document.addEventListener("keydown", function (e) {
              if (e.key === "ArrowLeft") {
                stopAuto();
                goTo(current - 1);
              }
              if (e.key === "ArrowRight") {
                stopAuto();
                goTo(current + 1);
              }
            });

            buildDots();
            goTo(0);
            startAuto();
          });
        </script>

        <script nonce="<%= cspNonce %>">
          /* ── PARTICLE EFFECT ── */
          (function () {
            var canvas = document.getElementById(
              "hsCanvas-template--20946532663474__hero_slider_JAVAdh",
            );
            var wrap = document.getElementById(
              "hs-template--20946532663474__hero_slider_JAVAdh",
            );
            if (!canvas || !wrap) return;

            /* Respect reduced motion */
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
              return;

            var ctx = canvas.getContext("2d");
            var W, H;
            var particles = [];
            var mouse = { x: -9999, y: -9999, active: false };
            var raf;
            var finePointer = window.matchMedia("(pointer: fine)").matches;

            /* Config */
            var COUNT_DESKTOP = 55;
            var COUNT_MOBILE = 28;
            var MOBILE_BP = 768;
            var MAX_DIST = 120;
            var MAX_DIST_SQ = MAX_DIST * MAX_DIST;
            var MAX_DIST_MOUSE = MAX_DIST * 1.4;
            var MAX_DIST_MOUSE_SQ = MAX_DIST_MOUSE * MAX_DIST_MOUSE;
            var SPEED = 0.35;
            var ATTRACT = 0.012;
            var MAX_SPEED = SPEED * 2.5;
            var EDGE_FADE = 80;

            /* Colours as RGBA components — alpha applied with edge fade */
            var COLORS = [
              [200, 16, 46, 0.18],
              [17, 17, 17, 0.1],
              [200, 16, 46, 0.1],
              [17, 17, 17, 0.06],
            ];

            function particleCount() {
              return window.innerWidth < MOBILE_BP
                ? COUNT_MOBILE
                : COUNT_DESKTOP;
            }

            function resize() {
              W = canvas.width = wrap.offsetWidth;
              H = canvas.height = wrap.offsetHeight;
            }

            function rand(min, max) {
              return min + Math.random() * (max - min);
            }

            function createParticle() {
              var c = COLORS[Math.floor(Math.random() * COLORS.length)];
              return {
                x: rand(0, W),
                y: rand(0, H),
                vx: rand(-SPEED, SPEED),
                vy: rand(-SPEED, SPEED),
                baseR: rand(1.5, 3.5),
                phase: rand(0, Math.PI * 2),
                r: c[0],
                g: c[1],
                b: c[2],
                a: c[3],
              };
            }

            function edgeFade(x, y) {
              var fx = Math.min(x, W - x) / EDGE_FADE;
              var fy = Math.min(y, H - y) / EDGE_FADE;
              if (fx > 1) fx = 1;
              if (fy > 1) fy = 1;
              if (fx < 0) fx = 0;
              if (fy < 0) fy = 0;
              return fx < fy ? fx : fy;
            }

            function init() {
              resize();
              particles = [];
              var n = particleCount();
              for (var i = 0; i < n; i++) particles.push(createParticle());
            }

            function draw() {
              ctx.clearRect(0, 0, W, H);

              for (var i = 0; i < particles.length; i++) {
                var a = particles[i];

                /* connect to mouse (desktop only) */
                if (mouse.active) {
                  var mdx = mouse.x - a.x;
                  var mdy = mouse.y - a.y;
                  var mdSq = mdx * mdx + mdy * mdy;
                  if (mdSq < MAX_DIST_MOUSE_SQ) {
                    var md = Math.sqrt(mdSq);
                    ctx.beginPath();
                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(mouse.x, mouse.y);
                    ctx.strokeStyle =
                      "rgba(200,16,46," +
                      0.08 * (1 - md / MAX_DIST_MOUSE) +
                      ")";
                    ctx.lineWidth = 0.6;
                    ctx.stroke();
                  }
                }

                /* connect to nearby particles — squared distance, no sqrt */
                for (var j = i + 1; j < particles.length; j++) {
                  var b = particles[j];
                  var dx = a.x - b.x;
                  var dy = a.y - b.y;
                  var dstSq = dx * dx + dy * dy;
                  if (dstSq < MAX_DIST_SQ) {
                    var alpha = 0.12 * (1 - dstSq / MAX_DIST_SQ);
                    ctx.beginPath();
                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(b.x, b.y);
                    ctx.strokeStyle = "rgba(17,17,17," + alpha + ")";
                    ctx.lineWidth = 0.5;
                    ctx.stroke();
                  }
                }
              }

              /* Draw particles — soft pulse + edge fade */
              for (var k = 0; k < particles.length; k++) {
                var p = particles[k];
                var pulseR = p.baseR + Math.sin(p.phase) * 0.4;
                var fade = edgeFade(p.x, p.y);
                ctx.beginPath();
                ctx.arc(p.x, p.y, pulseR, 0, Math.PI * 2);
                ctx.fillStyle =
                  "rgba(" +
                  p.r +
                  "," +
                  p.g +
                  "," +
                  p.b +
                  "," +
                  p.a * fade +
                  ")";
                ctx.fill();
              }
            }

            function update() {
              for (var i = 0; i < particles.length; i++) {
                var p = particles[i];

                /* mild cursor attraction */
                if (mouse.active) {
                  var mdx = mouse.x - p.x;
                  var mdy = mouse.y - p.y;
                  var mdSq = mdx * mdx + mdy * mdy;
                  if (mdSq < MAX_DIST_MOUSE_SQ && mdSq > 0.01) {
                    var md = Math.sqrt(mdSq);
                    p.vx += (mdx / md) * ATTRACT;
                    p.vy += (mdy / md) * ATTRACT;
                    var spd = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
                    if (spd > MAX_SPEED) {
                      p.vx = (p.vx / spd) * MAX_SPEED;
                      p.vy = (p.vy / spd) * MAX_SPEED;
                    }
                  }
                }

                p.x += p.vx;
                p.y += p.vy;
                p.phase += 0.025;

                /* bounce off walls */
                if (p.x < 0 || p.x > W) {
                  p.vx *= -1;
                  p.x = Math.max(0, Math.min(W, p.x));
                }
                if (p.y < 0 || p.y > H) {
                  p.vy *= -1;
                  p.y = Math.max(0, Math.min(H, p.y));
                }
              }
            }

            function loop() {
              update();
              draw();
              raf = requestAnimationFrame(loop);
            }

            /* Mouse tracking — skip on coarse pointers (touch) */
            if (finePointer) {
              wrap.addEventListener("mousemove", function (e) {
                var rect = canvas.getBoundingClientRect();
                mouse.x = e.clientX - rect.left;
                mouse.y = e.clientY - rect.top;
                mouse.active = true;
              });
              wrap.addEventListener("mouseleave", function () {
                mouse.x = -9999;
                mouse.y = -9999;
                mouse.active = false;
              });
            }

            /* Resize */
            var rt;
            window.addEventListener("resize", function () {
              clearTimeout(rt);
              rt = setTimeout(function () {
                init();
              }, 150);
            });

            /* Pause when tab hidden — save CPU */
            document.addEventListener("visibilitychange", function () {
              if (document.hidden) {
                cancelAnimationFrame(raf);
              } else {
                loop();
              }
            });

            init();
            loop();
          })();
        </script>
      </div>

