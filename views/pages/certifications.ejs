    <button class="cp-modal__nav cp-modal__nav--prev" id="cpNavPrev" onclick="cpNav(-1)" aria-label="Previous">&#8592;</button>
    <button class="cp-modal__nav cp-modal__nav--next" id="cpNavNext" onclick="cpNav(1)" aria-label="Next">&#8594;</button>

