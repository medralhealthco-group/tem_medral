<!-- ═══ LIGHTBOX JS ═══ -->
<script nonce="<%= cspNonce %>">
(function () {
  /* Build certifications data array */
  var certs = [
    
    {
      img:     "../assets/images/Udhyam_Certificate.jpg",
      title:   "UDYAM",
      issuer:  "MSME",
      validity:""
    },
    
    {
      img:     "../assets/images/FSSAI_Certificate.jpg",
      title:   "FSSAI",
      issuer:  "Food Safety Standards Authority India",
      validity:""
    },
    
    {
      img:     "../assets/images/GMP_Certificate.png",
      title:   "GMP Certified",
      issuer:  "Good Manufacturing Practice",
      validity:""
    },
    
    {
      img:     "../assets/images/WHO-GMP_CERTIFICATE.png",
      title:   "WHO-GMP",
      issuer:  "World Health Organization",
      validity:""
    },
    
    {
      img:     "../assets/images/HACCP-CERTIFICATE.png",
      title:   "HACCP",
      issuer:  "Hazard Analysis Critical Control Points",
      validity:""
    },
    
    {
      img:     "../assets/images/FDA_Certificate.png",
      title:   "FDA Certified",
      issuer:  "Food and Drug Administration",
      validity:""
    },
    
    {
      img:     "../assets/images/ISO_9001-2015_Certificate.png",
      title:   "ISO 9001:2015",
      issuer:  "International Organization for Standardization",
      validity:""
    },
    
    {
      img:     "../assets/images/ISO_45001-2018_CERFITICATE.png",
      title:   "ISO 45001-2018",
      issuer:  "Food Safety \u0026 Standards Authority of India",
      validity:""
    },
    
    {
      img:     "../assets/images/ISO_22000-2018_certificate.png",
      title:   "ISO 22000-2018",
      issuer:  "International Organization for Standardization",
      validity:""
    },
    
    {
      img:     "../assets/images/ISO_14001-2015_CERTIFICATE.png",
      title:   "ISO 14001-2015",
      issuer:  "International Organization for Standardization",
      validity:""
    }
    
  ];

  var modal      = document.getElementById('cpModal');
  var modalImg   = document.getElementById('cpModalImg');
  var modalTitle = document.getElementById('cpModalTitle');
  var modalMeta  = document.getElementById('cpModalMeta');
  var modalDL    = document.getElementById('cpModalDownload');
  var navPrev    = document.getElementById('cpNavPrev');
  var navNext    = document.getElementById('cpNavNext');
  var current    = 0;

  function render(idx) {
    current = idx;
    var c = certs[idx];
    if (!c) return;

    if (c.img && c.img !== '') {
      modalImg.src = c.img;
      modalImg.alt = c.title;
      modalImg.style.display = 'block';
      modalDL.href = c.img;
      modalDL.style.display = 'inline-flex';
    } else {
      modalImg.src = '';
      modalImg.style.display = 'none';
      modalDL.style.display = 'none';
    }

    modalTitle.textContent = c.title || '';
    var meta = [];
    if (c.issuer)   meta.push(c.issuer);
    if (c.validity) meta.push('Valid: ' + c.validity);
    modalMeta.textContent = meta.join(' · ');

    navPrev.disabled = (idx === 0);
    navNext.disabled = (idx >= certs.length - 1);
  }

  window.cpOpenModal = function (idx) {
    render(idx);
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  };

  window.cpCloseModal = function () {
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  };

  window.cpNav = function (dir) {
    var next = current + dir;
    if (next >= 0 && next < certs.length) render(next);
  };

  /* Close on backdrop click already handled by onclick in HTML */

  /* Keyboard navigation */
  document.addEventListener('keydown', function (e) {
    if (!modal.classList.contains('is-open')) return;
    if (e.key === 'Escape')     cpCloseModal();
    if (e.key === 'ArrowLeft')  cpNav(-1);
    if (e.key === 'ArrowRight') cpNav(1);
  });
})();
</script>


