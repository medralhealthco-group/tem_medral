<!-- ═══ MAIN — Form + Offices ═══ -->
<div class="ct-main">

  <!-- LEFT: Enquiry Form -->
  <div class="ct-form-col">
    <div class="ct-col-label">Send Us a Message</div>
    <h2 class="ct-col-title">Start Your Enquiry</h2>
    <p class="ct-col-sub">Fill in the details below and our team will prepare a tailored quote for you.</p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="em-error" role="alert" style="display:block; margin-bottom:16px;"><%= error %></div>
    <% } %>
    <% if (typeof reqQueryError !== 'undefined' && reqQueryError) { %>
      <div class="em-error" role="alert" style="display:block; margin-bottom:16px;"><%= reqQueryError %></div>
    <% } %>
    <form method="post" action="/contact" id="ContactPageForm" accept-charset="UTF-8" class="contact-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
      <input type="hidden" name="source" value="contact_page" />
      <div style="position:absolute; left:-9999px; top:auto; width:1px; height:1px; overflow:hidden;" aria-hidden="true">
        <label for="ContactWebsite">Website</label>
        <input type="text" id="ContactWebsite" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="ct-form-grid2">
        <div class="ct-field">
          <label class="ct-label" for="ContactName">Full Name <span>*</span></label>
          <input
            class="ct-input"
            type="text"
            id="ContactName"
            name="contact[name]"
            placeholder="Your full name"
            value=""
            required
          >
        </div>
        <div class="ct-field">
          <label class="ct-label" for="ContactCompany">Company / Brand</label>
          <input
            class="ct-input"
            type="text"
            id="ContactCompany"
            name="contact[company]"
            placeholder="Your company or brand name"
          >
        </div>
      </div>

      <div class="ct-form-grid2">
        <div class="ct-field">
          <label class="ct-label" for="ContactEmail">Email Address <span>*</span></label>
          <input
            class="ct-input"
            type="email"
            id="ContactEmail"
            name="contact[email]"
            placeholder="you@company.com"
            value=""
            required
          >
        </div>
        <div class="ct-field">
          <label class="ct-label" for="ContactPhone">Phone / WhatsApp <span>*</span></label>
          <input
            class="ct-input"
            type="tel"
            id="ContactPhone"
            name="contact[phone]"
            placeholder="+91 XXXXX XXXXX"
            required
          >
        </div>
      </div>

      <div class="ct-field">
        <label class="ct-label" for="ContactService">Service Required</label>
        <select class="ct-select" id="ContactService" name="contact[service]">
          <option value="">— Select a service —</option>
          <option>Third-Party Manufacturing</option>
          <option>Private Label</option>
          <option>White Labelling</option>
          <option>Custom Formulation</option>
          <option>Bulk Supply</option>
          <option>R&D / New Product Development</option>
          <option>General Enquiry</option>
        </select>
      </div>

      <div class="ct-form-grid2">
        <div class="ct-field">
          <label class="ct-label" for="ContactProduct">Product Category</label>
          <select class="ct-select" id="ContactProduct" name="contact[product_category]">
            <option value="">— Select category —</option>
            <option>Whey Protein / Mass Gainer</option>
            <option>Pre-Workout / BCAA / EAA</option>
            <option>Creatine / L-Glutamine</option>
            <option>Plant / Vegan Protein</option>
            <option>Fat Burner / Weight Loss</option>
            <option>Wellness Supplements</option>
            <option>Oats / Muesli / Foods</option>
            <option>Other / Not Sure</option>
          </select>
        </div>
        <div class="ct-field">
          <label class="ct-label" for="ContactQty">Estimated Quantity</label>
          <select class="ct-select" id="ContactQty" name="contact[quantity]">
            <option value="">— Approximate MOQ —</option>
            <option>Less than 100 units</option>
            <option>100 – 500 units</option>
            <option>500 – 2,000 units</option>
            <option>2,000 – 10,000 units</option>
            <option>10,000+ units</option>
          </select>
        </div>
      </div>

      <div class="ct-field">
        <label class="ct-label" for="ContactMessage">Your Requirement <span>*</span></label>
        <textarea
          class="ct-textarea"
          id="ContactMessage"
          name="contact[body]"
          rows="5"
          placeholder="Describe your product idea, flavours, packaging preferences, target market, or anything that helps us understand your vision..."
          required
        ></textarea>
      </div>

      <div class="ct-field ct-field--check">
        <label class="ct-check-label">
          <input type="checkbox" name="contact[newsletter]" value="yes" class="ct-checkbox">
          <span>Keep me updated on new formulations and industry insights</span>
        </label>
      </div>

      <button type="submit" class="ct-submit">
        Send Enquiry
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
