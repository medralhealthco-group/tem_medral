<!-- ═══ JAVASCRIPT ═══ -->
<script nonce="<%= cspNonce %>">
(function() {
  /* Tab switcher */
  window.faqSwitchTab = function(groupId) {
    var tabs = document.querySelectorAll('.faq-tab');
    for (var i = 0; i < tabs.length; i++) {
      var t = tabs[i];
      var active = t.getAttribute('data-group') === groupId;
      t.classList.toggle('faq-tab--active', active);
      t.setAttribute('aria-selected', active ? 'true' : 'false');
    }
    var panels = document.querySelectorAll('.faq-panel');
    for (var j = 0; j < panels.length; j++) {
      var p = panels[j];
      p.classList.toggle('faq-panel--active', p.id === 'faqPanel-' + groupId);
    }
  };

  /* Accordion toggle */
  window.faqToggle = function(id) {
    var item = document.getElementById('faqItem-' + id);
    if (!item) return;
    var ans = document.getElementById('faqAns-' + id);
    var btn = item.querySelector('.faq-item__q');
    var isOpen = item.classList.contains('is-open');

    /* Close all others in this panel */
    var panel = item.closest('.faq-panel');
    if (panel) {
      var openItems = panel.querySelectorAll('.faq-item.is-open');
      for (var i = 0; i < openItems.length; i++) {
        var el = openItems[i];
        if (el !== item) {
          el.classList.remove('is-open');
          var a = el.querySelector('.faq-item__a');
          var b = el.querySelector('.faq-item__q');
          if (a) a.setAttribute('hidden', '');
          if (b) b.setAttribute('aria-expanded', 'false');
        }
      }
    }

    /* Toggle current */
    if (isOpen) {
      item.classList.remove('is-open');
      if (btn) btn.setAttribute('aria-expanded', 'false');
      if (ans) ans.setAttribute('hidden', '');
    } else {
      item.classList.add('is-open');
      if (btn) btn.setAttribute('aria-expanded', 'true');
      if (ans) ans.removeAttribute('hidden');
    }
  };

  function attachFaqListeners() {
    var tabs = document.querySelectorAll('.faq-tab');
    tabs.forEach(function(t) {
      if (!t.dataset.faqBound) {
        t.dataset.faqBound = 'true';
        t.addEventListener('click', function(e) {
          e.preventDefault();
          var grp = this.getAttribute('data-group');
          if (grp) window.faqSwitchTab(grp);
        });
      }
    });

    var items = document.querySelectorAll('.faq-item');
    items.forEach(function(item) {
      var btn = item.querySelector('.faq-item__q');
      if (btn && !btn.dataset.faqBound) {
        btn.dataset.faqBound = 'true';
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var rawId = item.id.replace('faqItem-', '');
          if (rawId) window.faqToggle(rawId);
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachFaqListeners);
  } else {
    attachFaqListeners();
  }

  /* Keyboard: Escape closes open item */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.faq-item.is-open').forEach(function(item) {
        item.classList.remove('is-open');
        var a = item.querySelector('.faq-item__a');
        var b = item.querySelector('.faq-item__q');
        if (a) a.setAttribute('hidden', '');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
    }
  });
})();
</script>


