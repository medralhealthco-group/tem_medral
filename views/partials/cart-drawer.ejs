<!-- Mini Cart Side Overlay Drawer Component -->
<div id="miniCartOverlay" class="mini-cart-overlay" onclick="toggleCartDrawer(false)" aria-hidden="true"></div>

<aside id="miniCartDrawer" class="mini-cart-drawer" role="dialog" aria-modal="true" aria-label="Shopping cart" aria-hidden="true">
  <div class="mini-cart-header">
    <h3 class="mini-cart-header-title">
      Shopping Cart (<span id="miniCartHeaderCount">0</span>)
    </h3>
    <button type="button" class="mini-cart-close-btn" onclick="toggleCartDrawer(false)" aria-label="Close cart">&times;</button>
  </div>

  <div id="miniCartItemsContainer" class="mini-cart-body">
    <!-- Populated dynamically via assets/js/cart.js -->
    <div class="mini-cart-empty">Loading cart...</div>
  </div>

  <div class="mini-cart-footer">
    <div class="mini-cart-subtotal-row">
      <span>Subtotal:</span>
      <strong id="miniCartSubtotal">₹0.00</strong>
    </div>
    <div class="mini-cart-footer-actions">
      <a href="/cart" class="btn-drawer-cart" onclick="toggleCartDrawer(false)">View Cart</a>
      <a href="/checkout" class="btn-drawer-cart" onclick="toggleCartDrawer(false)">Checkout</a>
    </div>
  </div>
</aside>
