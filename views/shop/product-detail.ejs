<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include('../partials/head-seo') %>
    <% if (product) {
      const siteOrigin = (typeof seo !== 'undefined' && seo.siteOrigin) ? seo.siteOrigin : '';
      const absoluteImage = (img) => {
        if (!img) return siteOrigin ? siteOrigin + '/assets/images/medrallogo.png' : '/assets/images/medrallogo.png';
        if (/^https?:\/\//i.test(img)) return img;
        return siteOrigin ? siteOrigin + (img.startsWith('/') ? img : '/' + img) : img;
      };
      const productLd = {
        '@context': 'https://schema.org/',
        '@type': 'Product',
        name: product.title,
        image: [absoluteImage(product.primary_image || (product.images && product.images[0] && product.images[0].image_url))],
        description: product.short_description || product.title,
        sku: product.sku,
        brand: { '@type': 'Brand', name: product.brand || 'Medral Health' },
        offers: {
          '@type': 'Offer',
          url: typeof seo !== 'undefined' ? seo.canonicalUrl : '',
          priceCurrency: 'INR',
          price: String(product.sale_price || product.price),
          availability: product.stock_quantity > 0
            ? 'https://schema.org/InStock'
            : 'https://schema.org/OutOfStock',
          seller: { '@type': 'Organization', name: 'Medral Health Co' }
        }
      };
      const breadcrumbLd = {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin },
          { '@type': 'ListItem', position: 2, name: 'Shop', item: siteOrigin ? `${siteOrigin}/shop` : '' },
          {
            '@type': 'ListItem',
            position: 3,
            name: product.category_name || 'Category',
            item: siteOrigin ? `${siteOrigin}/shop/category/${product.category_slug || ''}` : ''
          },
          {
            '@type': 'ListItem',
            position: 4,
            name: product.title,
            item: typeof seo !== 'undefined' ? seo.canonicalUrl : ''
          }
        ]
      };
    %>
    <script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify(productLd).replace(/</g, '\\u003c') %></script>
    <script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c') %></script>
    <% } %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="/assets/css/fonts.css" rel="stylesheet" />
    <link href="/assets/css/storefront.bundle.css?v=<%= assetVersion %>" rel="stylesheet" type="text/css" media="all" />
  </head>
  <body>
    <%- include('../partials/header') %>

    <main class="detail-container" id="main-content" role="main" aria-label="Product Details">
      <!-- Breadcrumbs -->
      <nav class="detail-breadcrumbs">
        <a href="/">Home</a> &rsaquo;
        <a href="/shop">Shop</a> &rsaquo;
        <% if (product.category_slug) { %>
          <a href="/shop/category/<%= product.category_slug %>"><%= product.category_name %></a> &rsaquo;
        <% } %>
        <span><%= product.title %></span>
      </nav>

      <!-- Main Product Grid -->
      <div class="detail-main-grid">
        <!-- Gallery Side -->
        <div class="gallery-wrapper">
          <div class="main-img-box">
            <img
              id="mainProductImage"
              src="<%= product.images && product.images.length > 0 ? product.images[0].image_url : '/assets/images/Medral_Logo.png' %>"
              alt="<%= product.title %>"
              onerror="this.src='/assets/images/Medral_Logo.png';"
            />
          </div>

          <% if (product.images && product.images.length > 1) { %>
            <div class="thumbs-list">
              <% product.images.forEach((img, idx) => { %>
                <button
                  type="button"
                  class="thumb-btn <%= idx === 0 ? 'active' : '' %>"
                  onclick="switchMainImage('<%= img.image_url %>', this)"
                >
                  <img src="<%= img.image_url %>" alt="Thumbnail <%= idx + 1 %>" />
                </button>
              <% }); %>
            </div>
          <% } %>
        </div>

        <!-- Info Side -->
        <div class="detail-info">
          <div class="detail-brand"><%= product.brand %></div>
          <h1 class="detail-title"><%= product.title %></h1>

          <div class="detail-meta-row">
            <span>SKU: <code class="sku-code"><%= product.sku %></code></span>
            <span>Category: <strong><%= product.category_name %></strong></span>
            <% if (product.stock_quantity > 0) { %>
              <span class="stock-tag stock-in">&#10003; In Stock (<%= product.stock_quantity %>)</span>
            <% } else { %>
              <span class="stock-tag stock-out">&times; Out of Stock</span>
            <% } %>
          </div>

          <div class="price-box">
            <span class="price-current">₹<%= parseFloat(product.price).toFixed(2) %></span>
            <% if (product.sale_price) { %>
              <span class="price-old">₹<%= parseFloat(product.sale_price).toFixed(2) %></span>
              <span class="price-discount">SAVE ₹<%= (parseFloat(product.sale_price) - parseFloat(product.price)).toFixed(2) %></span>
            <% } %>
          </div>

          <% if (product.short_description) { %>
            <div class="detail-summary">
              <%= product.short_description %>
            </div>
          <% } %>

          <!-- Quantity Selector & Add to Cart -->
          <div class="qty-action-row">
            <span class="qty-label">Quantity:</span>
            <div class="qty-box">
              <button type="button" class="qty-btn" onclick="updateQty(-1)">-</button>
              <input type="number" id="detailQuantity" class="qty-input" value="1" min="1" max="<%= product.stock_quantity || 99 %>" readonly />
              <button type="button" class="qty-btn" onclick="updateQty(1)">+</button>
            </div>

            <% if (product.stock_quantity > 0) { %>
              <button
                type="button"
                class="btn-detail-add-cart"
                onclick="addToCart('<%= product.id %>', parseInt(document.getElementById('detailQuantity').value, 10))"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span>Add to Cart</span>
              </button>
            <% } else { %>
              <button type="button" disabled class="btn-out-of-stock">
                Out of Stock
              </button>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Specifications & Full Description -->
      <% if (product.full_description) { %>
        <div class="spec-card">
          <h2 class="spec-title">Product Details & Specifications</h2>
          <div class="spec-body"><%= product.full_description %></div>
        </div>
      <% } %>

      <!-- Related Products -->
      <% if (relatedProducts && relatedProducts.length > 0) { %>
        <section class="related-section">
          <h2 class="related-title">Related Products</h2>
          <div class="related-grid">
            <% relatedProducts.forEach(rel => { %>
              <div class="related-product-card">
                <a href="/shop/product/<%= rel.slug %>" class="related-img-wrap">
                  <img src="<%= rel.primary_image || '/assets/images/Medral_Logo.png' %>" alt="<%= rel.title %>" loading="lazy" decoding="async" />
                </a>
                <div class="related-info">
                  <div class="related-cat"><%= rel.category_name %></div>
                  <h4 class="related-product-title">
                    <a href="/shop/product/<%= rel.slug %>"><%= rel.title %></a>
                  </h4>
                  <div class="related-price">₹<%= parseFloat(rel.price).toFixed(2) %></div>
                </div>
              </div>
            <% }); %>
          </div>
        </section>
      <% } %>
    </main>

    <%- include('../partials/footer') %>

    <script nonce="<%= cspNonce %>">
      // Gallery Thumbnail Switcher
      function switchMainImage(url, btn) {
        document.getElementById('mainProductImage').src = url;
        document.querySelectorAll('.thumb-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
      }

      // Quantity Selector Controls
      function updateQty(delta) {
        const input = document.getElementById('detailQuantity');
        let current = parseInt(input.value || '1', 10);
        let max = parseInt(input.getAttribute('max') || '99', 10);
        current += delta;
        if (current < 1) current = 1;
        if (current > max) current = max;
        input.value = current;
      }
    </script>
  </body>
</html>
